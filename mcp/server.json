{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.cpenniman12/text2sql-mcp",
  "title": "text2sql",
  "description": "Keyless persistent Python and read-only SQL workspace for coding assistants.",
  "repository": {
    "url": "https://github.com/cpenniman12/text2sql-mcp",
    "source": "github"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "text2sql-mcp",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "TEXT2SQL_DATABASE_URL",
          "description": "SQLAlchemy datasource URL",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "TEXT2SQL_TRACE_MODE",
          "description": "Trace storage: local, database, or off (default local)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "TEXT2SQL_TRACE_FILE",
          "description": "Local JSONL trace path",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "TEXT2SQL_TRACE_DATABASE_URL",
          "description": "Optional separate database trace sink",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "TEXT2SQL_WORKSPACE_DIR",
          "description": "Local state directory (default .text2sql)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ]
}
